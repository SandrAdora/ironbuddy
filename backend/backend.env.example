# Copy this file to backend.env and fill in your values
# NEVER commit backend.env — it contains secrets

SECRET_KEY=your-django-secret-key-here
DEBUG=True

# AI provider: "groq" or "anthropic"
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL=

# Email (Gmail app password)
EMAIL_HOST_USER=your-email@gmail.com
CONTACT_EMAIL=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Optional search integration
SERPER_API_KEY=

# Leave commented locally to use SQLite; Render sets this automatically
# DATABASE_URL=postgres://user:pass@host:5432/dbname

ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
